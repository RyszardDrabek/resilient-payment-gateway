{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://127.0.0.1:3000"
    ]
  },
  "ConnectionStrings": {
    "PaymentDb": "Host=localhost;Port=5432;Database=payment_gateway;Username=postgres;Password=postgres",
    "RiskDb": "Host=localhost;Port=5432;Database=payment_gateway;Username=postgres;Password=postgres"
  },
  "RabbitMq": {
    "UseInMemory": true,
    "Host": "localhost",
    "Username": "guest",
    "Password": "guest"
  },
