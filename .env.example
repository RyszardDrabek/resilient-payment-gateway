# Copy to .env (never commit). Prefer User Secrets for local JWT / live Adyen.

ConnectionStrings__PaymentDb=Host=localhost;Port=5432;Database=payment_gateway;Username=postgres;Password=postgres
ConnectionStrings__RiskDb=Host=localhost;Port=5432;Database=payment_gateway;Username=postgres;Password=postgres

RabbitMq__UseInMemory=true
RabbitMq__Host=localhost
RabbitMq__Username=guest
RabbitMq__Password=guest

Auth__Issuer=payment-gateway
Auth__Audience=payment-gateway
Auth__JwtSigningKey=DEV_ONLY_CHANGE_ME_32CHARS_MINIMUM!!

# Free Community key from https://mediatr.io/ (optional; suppresses license warnings)
MEDIATR_LICENSE_KEY=

Settlement__ChannelId=adyen-wiremock
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
